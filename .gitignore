# OS / editor cruft
.DS_Store
Thumbs.db
.idea/
*.iml
.settings/

# Local deployment configuration and secrets
docker/.env
docker/tak-certs/
takserver-images-*.tar

# Official vendor installer and generated staging tree (trusted builder only)
docker/publish/vendor/*
!docker/publish/vendor/.gitignore
docker/publish/staging/*
!docker/publish/staging/.gitignore

# Python bytecode
__pycache__/
*.pyc
