# Copy to docker/.env for a pulled-image deployment. Do not commit .env.
# Tags are immutable release identifiers; change both together when upgrading.
TAK_IMAGE=ghcr.io/adamcabral86/takserver:5.7-43
TAK_DB_IMAGE=ghcr.io/adamcabral86/takserver-db:5.7-43
# Needed only while building/publishing images locally; it must match staging/<release>.
TAK_RELEASE=takserver-docker-5.7-RELEASE-43
TAK_CONFIG_VOLUME=tak_config
DB_VOLUME=tak_db_data

CERT_STATE=AB
CERT_CITY=EDMONTON
CERT_ORGANIZATION=H2A
CERT_ORGANIZATIONAL_UNIT=TAK
CERT_COUNTRY=CA
CERT_SERVER_CN=takserver
CERT_ADMIN_CN=admin
CERT_CA_CN=TAK-CA-01
CERT_PASS=atakatak
DB_PASS='Password1234!@!@'

ENABLE_CERT_ENROLLMENT=true
ENABLE_STORE_FORWARD_CHAT=true
ENABLE_FEDERATION=true
ENABLE_TLS=true
ENABLE_PLAINTEXT_TAK=false
ENABLE_SERVICE_ACCOUNT=true
CERT_SERVICE_CN=gateway-svc

# These are the initial password credentials for the enrollment/admin site.
ADMIN_USER=admin
ADMIN_PASSWORD='Password1234!@!@'

# These are the initial password credentials for a standard client.
CLIENT_USER=takuser1
CLIENT_PASSWORD='Password1234!@!@'

HOST_PORT_TAK_SSL=8089
HOST_PORT_TAK_PLAINTEXT=8087
HOST_PORT_HTTPS=8443
HOST_PORT_FED_HTTPS=8444
HOST_PORT_FED_V1=9000
HOST_PORT_FED_V2=9001
HOST_PORT_CERT_HTTPS=8446

# Optional override for the address printed in startup instructions. When
# blank and LE_FQDN is not set, deploy.sh tries AWS IMDSv2, the host's primary
# route-interface IP, then https://checkip.amazonaws.com. This does not change
# TAK networking.
PUBLIC_IP=

# Optional public certificate for the 8446 enrollment/password endpoint.
# 8089 and 8443 always use the deployment's TAK CA and client certificates.
# LE_FQDN must resolve publicly to this host and TCP 80 must be reachable.
LE_ENABLE=false
LE_FQDN=
LE_EMAIL=user@takserver.com
# Optional override for the federation webBaseUrl. Defaults to LE_FQDN.
FED_WEB_BASE_FQDN=

# Optional destination for exported admin and trust material. Defaults to
# docker/tak-certs. Do not distribute admin.p12 to enrolled users.
# CERTS_HOME_DIR=/home/ubuntu/tak-certs
WAIT_TIMEOUT_SEC=300
