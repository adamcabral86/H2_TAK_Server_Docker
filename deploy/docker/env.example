# Copy to .env and edit. Used by docker-compose.yml and the init container.
#
#   cp env.example .env
#   export COMPOSE_BAKE=false   # classic builder — avoids requiring the buildx plugin
#   docker compose --env-file .env up -d --build

# Which staged release to run. This must match a directory name under staging/
# (i.e. the top-level folder inside the vendor takserver-docker-*.zip, and
# what prepare-tak-docker.sh prints after staging it). Changing this and
# re-running `docker compose up -d --build` is how you switch versions —
# see AUTO_UPGRADE.md / MANUAL_UPGRADE.md for doing this safely with an
# existing database.
TAK_RELEASE=takserver-docker-5.7-RELEASE-43

# Certificate subject
CERT_STATE=AB
CERT_CITY=EDMONTON
CERT_ORGANIZATION=H2A
CERT_ORGANIZATIONAL_UNIT=TAK
CERT_COUNTRY=CA

# Common names for generated certs
CERT_SERVER_CN=takserver
CERT_ADMIN_CN=admin
# Intermediate issuing CA (creates ${CERT_CA_CN}-signing.jks for enrollment)
CERT_CA_CN=TAK-CA-01
# Wire <certificateSigning> into CoreConfig on init (true/false)
ENABLE_CERT_ENROLLMENT=true
# Chat store-and-forward (CoreConfig buffer/queue enableStoreForwardChat)
ENABLE_STORE_FORWARD_CHAT=true
# Wire <federation><federation-server> into CoreConfig on init (ports 9000/9001,
# published below regardless — this actually turns federation on). Uses the same
# server keystore; creates fed-truststore.jks (seeded from the local CA truststore)
# if it doesn't exist yet. Set LE_FQDN or FED_WEB_BASE_FQDN to also fill in webBaseUrl.
ENABLE_FEDERATION=true
# CoT input(s). ENABLE_TLS and ENABLE_PLAINTEXT_TAK are independent — you
# can run either one alone or both at once (e.g. normal clients on 8089,
# a test client on 8087 for a Wireshark capture, at the same time).
#   ENABLE_TLS=true            CoT listener on 8089 (stdssl, normal/secure)
#   ENABLE_PLAINTEXT_TAK=true  CoT listener on 8087 (streamtcp, protocol=stcp,
#                              anonymous auth) — CoT traffic is readable in a
#                              Wireshark capture; clients on it still see each
#                              other normally (plain protocol=tcp would be
#                              publish-only and NOT broadcast between clients)
# Neither affects the web UI — 8443/8444/8446 stay HTTPS either way. After
# changing either on an existing deployment, re-run ./post-start.sh (it
# adds/removes the CoreConfig <input> line and restarts tak as needed).
ENABLE_TLS=true
ENABLE_PLAINTEXT_TAK=false

# PKCS12 / JKS password (browser import + CoreConfig keystorePass)
CERT_PASS=atakatak

# Postgres / martiuser password written into CoreConfig.xml
DB_PASS=TakDbPass123

# Optional: username/password admin for https://<host>:8446 (File auth).
# Leave empty / commented to skip. Quote the value if it has ! $ etc:
ADMIN_PASSWORD='Password1234!@!@'
ADMIN_USER=admin

# Host port mappings (left side = host, right side fixed in container)
HOST_PORT_TAK_SSL=8089
HOST_PORT_TAK_PLAINTEXT=8087
HOST_PORT_HTTPS=8443
HOST_PORT_FED_HTTPS=8444
HOST_PORT_FED_V1=9000
HOST_PORT_FED_V2=9001
HOST_PORT_CERT_HTTPS=8446

# Name of the Docker volume PostgreSQL data is stored in. Leave as-is normally.
# Only set this to something else when migrating a database across a Postgres
# major-version bump (see AUTO_UPGRADE.md / MANUAL_UPGRADE.md) — a new name
# here gives you a fresh, empty volume to restore into instead of reusing one
# that's incompatible with the new release's Postgres version.
DB_VOLUME=tak_db_data

# ---------------------------------------------------------------------------
# Public FQDN (Let's Encrypt + federation webBaseUrl)
# Does NOT replace TAK client mTLS CA. Applies a public cert to HTTPS :8446
# (password / enrollment UI). 8443 and 8089 keep the TAK CA.
#
# LE_FQDN is also written into CoreConfig federation webBaseUrl as
# https://<LE_FQDN>:8443/Marti (fixes Docker internal IP on install).
# Override with FED_WEB_BASE_FQDN if federation should use a different host.
#
# After compose is up, ./post-start.sh waits for TAK, promotes admin,
# runs apply-letsencrypt.sh when LE_ENABLE=true, then copies certs to
# CERTS_HOME_DIR (default: ~/takserver-certs).
#
# Needs: DNS A/AAAA for LE_FQDN → this host, TCP 80 open to the internet,
#        certbot + openssl on the host.
# Federation: open 8444, 9000, 9001/tcp to peer TAK servers (SG/firewall).
# ---------------------------------------------------------------------------
LE_ENABLE=true
LE_FQDN=takdocker.h2tak.ca
LE_EMAIL=user@tak.com
# FED_WEB_BASE_FQDN=takdocker.h2tak.ca
# Optional overrides (leave commented or set a real path — do not set empty):
# CERTS_HOME_DIR=/home/ubuntu/takserver-certs
# WAIT_TIMEOUT_SEC=300
