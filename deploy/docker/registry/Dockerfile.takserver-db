# Database image for registry-based deployments. The TAK database bootstrap
# scripts live alongside the runtime at /opt/tak.
FROM postgres:15-bookworm

RUN apt-get update \
    && apt-get install -y --no-install-recommends postgresql-15-postgis-3 openjdk-17-jdk \
    && rm -rf /var/lib/apt/lists/*

COPY tak/ /opt/tak/

ENTRYPOINT ["/opt/tak/db-utils/configureInDocker.sh"]
